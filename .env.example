# Prism — Hedera testnet. Copy to .env and fill in.
# Generate a fresh operator with: npm run keygen

# ECDSA, not ED25519 — @x402/hedera's live path and both public facilitators
# assume ECDSA for the client and fee payer.
OPERATOR_KEY=
OPERATOR_EVM_ADDRESS=
# Left blank until the account exists; `npm run whoami` fills it in once funding
# has auto-created the account.
OPERATOR_ID=

HEDERA_NETWORK=testnet
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# Public facilitators, both verified working. Swap freely — Prism runs against
# unmodified ones on purpose.
#   https://x402.org/facilitator          feePayer 0.0.9185802
#   https://api.testnet.blocky402.com     feePayer 0.0.7162784
FACILITATOR_URL=https://x402.org/facilitator

PORT=4051
PUBLIC_ORIGIN=http://localhost:4051
PRISM_ORIGIN=http://localhost:4051

# Shared secret between the agent and its co-signer. Generate with:
#   openssl rand -hex 24
POLICY_TOKEN=
POLICY_PORT=4052
POLICY_URL=http://localhost:4052

# Asset generation for the studio demo. Models are addressed by id; the key is
# never committed. lyria-3-pro-preview is deliberately not used — it returns
# segment markers instead of audio.
ASSET_API_KEY=
IMAGE_MODEL=google/gemini-3.1-flash-lite-image
TTS_MODEL=google/gemini-3.1-flash-tts-preview
MUSIC_MODEL=google/lyria-3-clip-preview
