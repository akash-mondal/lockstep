# Lockstep, on Hedera testnet. Copy to .env and fill in.
# Generate a fresh operator with: npm run keygen

# ECDSA, not ED25519. @x402/hedera's live path and both public facilitators
# assume ECDSA for the client and the fee payer.
OPERATOR_KEY=
OPERATOR_EVM_ADDRESS=
# Left blank until the account exists. `npm run whoami` fills it in once funding
# has auto-created the account.
OPERATOR_ID=

HEDERA_NETWORK=testnet
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# Public facilitators, both verified working. Swap freely; Lockstep runs against
# unmodified ones on purpose.
#   https://x402.org/facilitator          feePayer 0.0.9185802
#   https://api.testnet.blocky402.com     feePayer 0.0.7162784
FACILITATOR_URL=https://x402.org/facilitator

# ---------------------------------------------------------------- the primitive
# The resource server and the co-signer that holds the agent's second key.
PORT=4051
PUBLIC_ORIGIN=http://localhost:4051
LOCKSTEP_ORIGIN=http://localhost:4051

# Shared secret between the agent and its co-signer. Generate with:
#   openssl rand -hex 24
POLICY_TOKEN=
POLICY_PORT=4052
POLICY_HOST=127.0.0.1
POLICY_URL=http://localhost:4052

# The token the /v1/token/:id/cost route quotes fees for. This is the subject of
# the question, not the payment asset; everything is paid for in HBAR.
USDC_TOKEN_ID=0.0.429274

# ------------------------------------------------------------------ the foundry
# Five generative models sold over x402, one settlement per call. This account is
# the seller and needs no balance beyond what it collects.
FOUNDRY_PORT=4061
FOUNDRY_ORIGIN=http://localhost:4061
FOUNDRY_OPERATOR_ID=
FOUNDRY_OPERATOR_KEY=

# Models are addressed by id and the key is never committed. lyria-3-pro-preview
# is deliberately not used: it returns segment markers instead of audio.
ASSET_API_KEY=
OPENROUTER_API_KEY=
IMAGE_MODEL=google/gemini-3.1-flash-lite-image
TTS_MODEL=google/gemini-3.1-flash-tts-preview
MUSIC_MODEL=google/lyria-3-clip-preview
VISION_MODEL=google/gemini-3.1-flash

# Transcription, for word timings so captions land on the spoken word.
STT_API_KEY=
STT_MODEL=scribe_v1

# ------------------------------------------------------------------- the studio
# The agent that buys its own materials. Two accounts on purpose: the studio is
# paid at one, and spends from another. They are separate so a compromised agent
# reaches only the spending wallet, never the takings.
STUDIO_PORT=4071
STUDIO_ORIGIN=http://localhost:4071
STUDIO_WALLET_ID=
STUDIO_WALLET_KEY=

# The buyer, for `npm run verify` and the demo scripts.
BUYER_ID=
BUYER_KEY=

# Where job workspaces are written. One directory per job; the agent is confined
# to its own by cwd.
SESSIONS_ROOT=./sessions

# How long one agent turn may run before it is aborted, and how many times the
# gate may fail before the job does. A stuck agent holds a paid job open, and the
# buyer has already been charged.
STUDIO_TURN_TIMEOUT_MS=1500000
STUDIO_FIX_PASSES=2
